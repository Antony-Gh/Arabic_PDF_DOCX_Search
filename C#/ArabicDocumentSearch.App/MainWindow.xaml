<Window x:Class="ArabicDocumentSearch.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arabic Document Search" Height="760" Width="1180" MinHeight="600" MinWidth="900"
        Background="{DynamicResource WindowBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Arabic Document Search" FontSize="28" FontWeight="SemiBold" Foreground="#17202A" />
        <Border Grid.Row="1" Margin="0,22,0,10" Padding="16" Background="{DynamicResource PanelBrush}" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="Documents folder" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBox Grid.Column="1" Margin="16,0,8,0" Text="{Binding RootFolder, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="2" Content="Browse" Click="BrowseFolder_Click" />
                <Button Grid.Column="3" Content="Exclude folders" Click="ExcludeFolder_Click" />
                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="16,8,0,0" Text="{Binding ExcludedFolders}" Foreground="#667085" TextWrapping="Wrap" />
            </Grid>
        </Border>
        <Border Grid.Row="2" Padding="16" Background="{DynamicResource PanelBrush}" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" FontSize="16" Padding="10" KeyDown="Query_KeyDown" />
                <Button Grid.Column="1" Content="Search" Command="{Binding SearchCommand}" />
                <Button Grid.Column="2" Content="Index files" Command="{Binding IndexCommand}" />
            </Grid>
        </Border>
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <StackPanel>
                <ProgressBar Height="8" Value="{Binding Progress, Mode=OneWay}" Maximum="100" />
                <DockPanel Margin="0,8,0,8">
                    <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelCommand}" />
                    <TextBlock Text="{Binding Status}" Foreground="#475467" />
                </DockPanel>
                <TextBlock Text="{Binding CurrentFile}" Foreground="#667085" TextTrimming="CharacterEllipsis" />
                <WrapPanel Margin="0,6,0,0">
                    <TextBlock Text="{Binding Started}" Margin="0,0,18,0" Foreground="#667085" />
                    <TextBlock Text="{Binding Elapsed}" Margin="0,0,18,0" Foreground="#667085" />
                    <TextBlock Text="{Binding Remaining}" Margin="0,0,18,0" Foreground="#667085" />
                    <TextBlock Text="{Binding Completion}" Margin="0,0,18,0" Foreground="#667085" />
                    <TextBlock Text="{Binding Speed}" Foreground="#667085" />
                </WrapPanel>
            </StackPanel>
            <DataGrid Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding Results}" AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="Results_MouseDoubleClick" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="220" />
                    <DataGridTextColumn Header="Page / location" Binding="{Binding Location}" Width="120" />
                    <DataGridTextColumn Header="Path" Binding="{Binding FullPath}" Width="260" />
                    <DataGridTextColumn Header="Context" Binding="{Binding Snippet}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <TextBlock Grid.Row="4" Margin="0,14,0,0" Text="All indexing and search data stays on this computer." Foreground="#667085" />
    </Grid>
</Window>
