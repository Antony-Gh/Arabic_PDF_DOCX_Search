<Window x:Class="ArabicDocumentSearch.App.ExtractedTextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Extracted Text" Height="700" Width="1000">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{Binding Header}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Quality}" Foreground="#667085" Margin="0,4,0,10" />
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <GroupBox Header="Original extracted text" Margin="0,0,8,0"><TextBox Text="{Binding OriginalText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FlowDirection="RightToLeft" /></GroupBox>
            <GroupBox Grid.Column="1" Header="Normalized indexed text" Margin="8,0,0,0"><TextBox Text="{Binding NormalizedText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FlowDirection="RightToLeft" /></GroupBox>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"><Button Content="Copy original" Click="CopyOriginal_Click"/><Button Content="Copy normalized" Click="CopyNormalized_Click"/><Button Content="Export text" Click="Export_Click"/></StackPanel>
    </Grid>
</Window>
